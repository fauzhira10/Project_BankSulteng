# =====================================================================
# Template konfigurasi SERVER PRODUKSI — Jurnal Keluhan Bank Sulteng
# =====================================================================
# Cara pakai di server:
#   cp .env.production.example .env
#   php artisan key:generate
#   php artisan migrate --force
#   php artisan db:seed --class=MasterSeeder --force
#   php artisan admin:buat --superadmin
#   php artisan config:cache && php artisan route:cache && php artisan view:cache
#
# Jangan pernah menjalankan `php artisan db:seed` polos di server ini:
# akun contoh CS hanya dibuat di lingkungan pengembangan, tetapi MasterSeeder
# tetap perlu dijalankan terpisah seperti perintah di atas.
# ---------------------------------------------------------------------

APP_NAME="Jurnal Keluhan Bank Sulteng"

# WAJIB production. Nilai "local" membuat Laravel longgar terhadap galat.
APP_ENV=production

# WAJIB kosong di berkas ini; diisi oleh `php artisan key:generate` di server.
APP_KEY=

# WAJIB false. Nilai true menampilkan stack trace berisi kredensial database
# dan seluruh isi .env kepada siapa pun yang memicu galat.
APP_DEBUG=false

# WAJIB https:// agar tautan yang dihasilkan aplikasi tidak turun ke HTTP.
APP_URL=https://ganti-dengan-domain-anda

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
# Jangan debug di produksi: isi log akan memuat data nasabah.
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=jurnal_banksulteng
# JANGAN memakai root. Buat pengguna khusus dengan hak seperlunya:
#   CREATE USER 'jurnal_app'@'127.0.0.1' IDENTIFIED BY '<kata sandi panjang & acak>';
#   GRANT SELECT, INSERT, UPDATE, DELETE ON jurnal_banksulteng.* TO 'jurnal_app'@'127.0.0.1';
# Hak DDL (CREATE/ALTER/DROP) diberikan sementara hanya saat menjalankan migrasi.
DB_USERNAME=jurnal_app
DB_PASSWORD=

SESSION_DRIVER=database
# Sesi petugas berumur pendek; layar yang ditinggalkan tidak boleh tetap terbuka.
SESSION_LIFETIME=30
SESSION_CONCURRENT_TIMEOUT=30
# Isi sesi ikut terenkripsi di tabel sessions.
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# WAJIB true: cookie sesi hanya boleh melintas lewat HTTPS.
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=strict

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@banksulteng.co.id"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Blockchain jejak audit (DOCUMENTATION.md bagian 8.11). Blockchain lokal selalu
# berjalan; penjangkaran ke Ethereum hanya bila server punya jalur keluar ke internet.
BLOCKCHAIN_UKURAN_BLOK=10
BLOCKCHAIN_KESULITAN=4
ETH_JANGKAR_AKTIF=false
ETH_RPC_URL=
ETH_KUNCI_PRIVAT=
ETH_ALAMAT_KONTRAK=
ETH_BLOK_DEPLOY=
ETH_PENJELAJAH=https://sepolia.etherscan.io
NODE_BIN=node
